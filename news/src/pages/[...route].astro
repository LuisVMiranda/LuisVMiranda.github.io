---
import Shell from '../layouts/Shell.astro';
import Home from '../views/Home.astro';
import ArticleView from '../views/Article.astro';
import Search from '../views/Search.astro';
import Archive from '../views/Archive.astro';
import Editorial from '../views/Editorial.astro';
import ErrorPage from '../views/ErrorPage.astro';
import { loadCatalog } from '../modules/content/catalog';
import { sections, sectionLabel } from '../modules/content/sections';
import { routePath } from '../modules/content/urls';
import type {
  Article,
  Edition,
  Locale,
  SectionId,
} from '../modules/content/types';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { archiveRoutes } from '../modules/editions/routes';

export async function getStaticPaths() {
  const { articles, editions } = await loadCatalog();
  const locales: Locale[] = ['pt-BR', 'en'];
  return locales.flatMap((locale) => {
    const common = { locale, articles, editions };
    const fixed = ['', 'busca', 'editorial', '404'];
    const archive = archiveRoutes(editions);
    const routes = [
      ...fixed,
      ...sections.map((section) => `secao/${section.id}`),
      ...articles.map((article) => `artigos/${article.slug}`),
      ...editions.map((edition) => `edicao/${edition.id}`),
      ...archive.map((item) => item.path),
    ];
    return routes.map((path) => ({
      params: {
        route: routePath(path, locale).replace(/^\/+|\/+$/g, '') || undefined,
      },
      props: { ...common, path, ...archive.find((item) => item.path === path) },
    }));
  });
}

interface Props {
  locale: Locale;
  path: string;
  articles: Article[];
  editions: Edition[];
  page?: number;
  pageCount?: number;
  sectionFilter?: SectionId;
}
const { locale, path, articles, editions, page, pageCount, sectionFilter } =
  Astro.props;
const sectionId = path.startsWith('secao/')
  ? (path.split('/')[1] as SectionId)
  : undefined;
const article = articles.find((entry) => path === `artigos/${entry.slug}`);
const edition = path.startsWith('edicao/')
  ? editions.find((entry) => path === `edicao/${entry.id}`)
  : editions[0];
const sectionModules = import.meta.glob<{ default: AstroComponentFactory }>(
  '../views/sections/*.astro',
  { eager: true },
);
const sectionModule = Object.entries(sectionModules).find(([name]) =>
  name.toLowerCase().endsWith(`/${sectionId}.astro`),
);
const Section = sectionModule?.[1].default;
if (sectionId && !Section)
  throw new Error(`Missing section design: ${sectionId}`);
const titleMap: Record<string, string> =
  locale === 'en'
    ? {
        '': 'The stories that matter',
        busca: 'Search',
        arquivo: 'Edition archive',
        editorial: 'Editorial policy',
        '404': 'Page not found',
      }
    : {
        '': 'O que importa hoje',
        busca: 'Buscar',
        arquivo: 'Arquivo de edições',
        editorial: 'Política editorial',
        '404': 'Página não encontrada',
      };
const title =
  article?.translations[locale].title ||
  (sectionId
    ? sectionLabel(sectionId, locale)
    : titleMap[path.startsWith('arquivo/') ? 'arquivo' : path]) ||
  (locale === 'en' ? 'Edition' : 'Edição');
const related = article
  ? articles
      .filter(
        (entry) => entry.id !== article.id && entry.section === article.section,
      )
      .slice(0, 3)
  : [];
---

<Shell
  locale={locale}
  title={title}
  path={path}
  {...(article
    ? { article, description: article.translations[locale].summary }
    : {})}
>
  {path === '' && (
    <Home
      locale={locale}
      articles={articles}
      {...(edition ? { edition } : {})}
    />
  )}
  {path === 'busca' && <Search locale={locale} />}
  {(path === 'arquivo' || path.startsWith('arquivo/')) && (
    <Archive
      locale={locale}
      articles={articles}
      editions={editions}
      {...(page ? { page } : {})}
      {...(pageCount ? { pageCount } : {})}
      {...(sectionFilter ? { sectionFilter } : {})}
    />
  )}
  {path === 'editorial' && <Editorial locale={locale} />}
  {path === '404' && <ErrorPage locale={locale} />}
  {sectionId && Section && (
    <Section
      locale={locale}
      articles={articles}
      {...(edition ? { edition } : {})}
    />
  )}
  {article && (
    <ArticleView locale={locale} article={article} related={related} />
  )}
  {path.startsWith('edicao/') && edition && (
    <Archive
      locale={locale}
      articles={articles}
      editions={[edition]}
      selectedEdition={edition}
    />
  )}
</Shell>
