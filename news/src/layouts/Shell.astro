---
import '../styles/global.css';
import type { Locale, Article } from '../modules/content/types';
import { sections, sectionStyle } from '../modules/content/sections';
import { articleDate, assetUrl, localUrl } from '../modules/content/urls';
import { previewMode } from '../modules/content/catalog';
interface Props {
  locale: Locale;
  title: string;
  description?: string;
  path: string;
  article?: Article;
}
const { locale, title, path, article } = Astro.props;
const en = locale === 'en';
const description =
  Astro.props.description ??
  (en
    ? 'Verified news. Sources, context and clarity.'
    : 'Notícias verificadas. Fontes, contexto e clareza.');
const alternate = en ? 'pt-BR' : 'en';
const canonical = new URL(localUrl(path, locale), Astro.site);
const structured = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      headline: article.translations[locale].title,
      description: article.translations[locale].summary,
      datePublished: articleDate(article),
      dateModified:
        article.updatedAt === article.publishedAt
          ? articleDate(article)
          : article.updatedAt,
      inLanguage: locale,
      mainEntityOfPage: canonical.href,
      author: { '@type': 'Organization', name: 'Notícias' },
      citation: article.sources.map((source) => source.url),
    }
  : null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Notícias</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {(previewMode || path === '404' || path === 'busca') && (
      <meta name="robots" content="noindex,nofollow" />
    )}
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang="pt-BR"
      href={new URL(localUrl(path, 'pt-BR'), Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(localUrl(path, 'en'), Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localUrl(path, 'pt-BR'), Astro.site)}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Notícias RSS"
      href={assetUrl(en ? 'en/rss.xml' : 'rss.xml')}
    />
    <link rel="icon" href={assetUrl('favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content={en ? 'en_US' : 'pt_BR'} />
    {structured && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structured).replace(/</g, '\\u003c')}
      ></script>
    )}
    <script is:inline>
      try {
        const p = JSON.parse(
          localStorage.getItem('noticias.preferences.v1') || '{}',
        );
        const system = matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
        document.documentElement.dataset.theme = ['light', 'dark'].includes(
          p.theme,
        )
          ? p.theme
          : system;
        if ([16, 18, 20, 22, 24].includes(p.fontSize))
          document.documentElement.style.setProperty(
            '--article-size',
            p.fontSize + 'px',
          );
      } catch {
        document.documentElement.dataset.theme = matchMedia(
          '(prefers-color-scheme: dark)',
        ).matches
          ? 'dark'
          : 'light';
      }
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link" tabindex="0">
      {en ? 'Skip to content' : 'Ir para o conteúdo'}
    </a>
    <header class="container" data-pagefind-ignore>
      <div class="masthead">
        <a class="brand" href={localUrl('', locale)}>
          Notícias
          <span>
            {en ? 'Sources. Context. Clarity.' : 'Fontes. Contexto. Clareza.'}
          </span>
        </a>
        <div class="utilities">
          <a href={localUrl('busca', locale)} class="search-link">
            {en ? 'Search' : 'Buscar'} <span aria-hidden="true">↗</span>
          </a>
          <a
            href={localUrl(path, alternate)}
            lang={alternate}
            hreflang={alternate}
            aria-label={en ? 'Ler em português' : 'Read in English'}
          >
            {en ? 'PT-BR' : 'EN'}
          </a>
          <button
            data-theme-toggle
            data-light-label={en ? 'Switch to light mode' : 'Ativar modo claro'}
            data-dark-label={en ? 'Switch to dark mode' : 'Ativar modo escuro'}
            aria-label={en ? 'Switch theme' : 'Alternar tema'}
          >
            <svg
              class="sun"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
            </svg>
            <svg
              class="moon"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M20.5 14A8.6 8.6 0 0 1 10 3.5 8.7 8.7 0 1 0 20.5 14Z" />
            </svg>
          </button>
        </div>
      </div>
      <nav class="desktop-nav" aria-label={en ? 'Sections' : 'Editorias'}>
        {sections.map((section) => (
          <a
            style={sectionStyle(section.id)}
            href={localUrl(`secao/${section.id}`, locale)}
            aria-current={path === `secao/${section.id}` ? 'page' : undefined}
          >
            {section.label[locale]}
          </a>
        ))}
      </nav>
      <details class="mobile-nav">
        <summary>{en ? 'Browse sections' : 'Explorar editorias'}</summary>
        <nav aria-label={en ? 'Mobile sections' : 'Editorias no celular'}>
          {sections.map((section) => (
            <a
              style={sectionStyle(section.id)}
              href={localUrl(`secao/${section.id}`, locale)}
            >
              {section.label[locale]}
            </a>
          ))}
          <a href={localUrl('busca', locale)}>{en ? 'Search' : 'Buscar'}</a>
        </nav>
      </details>
    </header>
    {previewMode && (
      <aside class="preview-banner">
        {en
          ? 'Editorial preview · Content awaiting approval'
          : 'Prévia editorial · Conteúdo aguardando aprovação'}
      </aside>
    )}
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="container" data-pagefind-ignore>
      <div class="footer-brand">
        Notícias
        <span>
          {en
            ? 'A little context. A clearer day.'
            : 'Mais contexto. Um dia mais claro.'}
        </span>
      </div>
      <nav aria-label={en ? 'Footer' : 'Rodapé'}>
        <a href={localUrl('arquivo', locale)}>{en ? 'Archive' : 'Arquivo'}</a>
        <a href={localUrl('editorial', locale)}>
          {en ? 'Editorial policy' : 'Política editorial'}
        </a>
        <a href={assetUrl(en ? 'en/rss.xml' : 'rss.xml')}>RSS</a>
      </nav>
    </footer>
    <script>
      import '../modules/preferences/client';
    </script>
  </body>
</html>
<style>
  .masthead {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 2rem;
  }
  .brand {
    font-family: 'Source Serif 4', serif;
    font-size: 2.8rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    letter-spacing: -0.055em;
  }
  .brand span {
    display: block;
    font:
      0.65rem 'Inter',
      sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.8rem;
  }
  .utilities {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    font-size: 0.8rem;
  }
  .utilities a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .utilities button {
    display: grid;
    place-items: center;
    border: 0;
    padding: 0.65rem;
  }
  .desktop-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    border-block: 1px solid var(--rule);
  }
  .desktop-nav a {
    font-size: 0.8rem;
    min-height: 48px;
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--section-accent);
    text-decoration: underline;
  }
  .mobile-nav {
    display: none;
    border-block: 1px solid var(--rule);
  }
  .mobile-nav summary {
    padding: 0.8rem 0;
    cursor: pointer;
  }
  .mobile-nav nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .mobile-nav a {
    padding: 0.7rem 0;
    font-size: 0.9rem;
  }
  .moon {
    display: none;
  }
  :global([data-theme='dark']) .sun {
    display: none;
  }
  :global([data-theme='dark']) .moon {
    display: block;
  }
  main {
    padding-block: 2.5rem 4rem;
  }
  footer {
    border-top: 1px solid var(--rule);
    padding-block: 2rem;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .footer-brand {
    font-family: 'Source Serif 4', serif;
    font-size: 1.5rem;
  }
  .footer-brand span {
    display: block;
    font:
      0.75rem 'Inter',
      sans-serif;
    color: var(--muted);
    margin-top: 0.5rem;
  }
  footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    align-items: center;
    font-size: 0.8rem;
  }
  .preview-banner {
    text-align: center;
    font-size: 0.8rem;
    padding: 0.5rem;
    background: var(--surface);
  }
  @media (max-width: 650px) {
    .desktop-nav {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
    .brand {
      font-size: 2.2rem;
    }
    .brand span {
      max-width: 145px;
      line-height: 1.6;
    }
    .utilities {
      gap: 0.5rem;
    }
    .search-link {
      display: none !important;
    }
  }
</style>
