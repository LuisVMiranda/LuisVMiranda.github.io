---
import type { Article } from '../modules/content/types';
import { sectionLabel, sections } from '../modules/content/sections';
import {
  articleUrl,
  sectionUrl,
  articleDate,
  formatArticleDate,
  formatDate,
  localUrl,
} from '../modules/content/urls';
import StoryCard from '../components/StoryCard.astro';

interface Props {
  locale: 'pt-BR' | 'en';
  article: Article;
  related: Article[];
}

const { locale, article, related } = Astro.props;
const translation = article.translations[locale];
const currentSection = sections.find((item) => item.id === article.section)!;
const currentSectionLabel = sectionLabel(article.section, locale);
const readingWords = [
  translation.title,
  translation.summary,
  ...translation.paragraphs,
]
  .join(' ')
  .trim()
  .split(/\s+/)
  .filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(readingWords / 200));
const hasUpdate = Boolean(
  article.updatedAt && article.updatedAt !== article.publishedAt,
);
const copy =
  locale === 'pt-BR'
    ? {
        article: 'Artigo',
        byline: 'Fonte',
        published: 'Publicado',
        updated: 'Atualizado',
        minute: 'min de leitura',
        textSize: 'Tamanho do texto',
        increase: 'Aumentar tamanho do texto',
        decrease: 'Diminuir tamanho do texto',
        correction: 'Correção',
        sources: 'Fontes',
        related: 'Leia também',
        backToSection: `Mais notícias de ${currentSectionLabel}`,
        permalink: 'Link permanente',
      }
    : {
        article: 'Article',
        byline: 'Source',
        published: 'Published',
        updated: 'Updated',
        minute: 'min read',
        textSize: 'Text size',
        increase: 'Increase text size',
        decrease: 'Decrease text size',
        correction: 'Correction',
        sources: 'Sources',
        related: 'More stories',
        backToSection: `More news from ${currentSectionLabel}`,
        permalink: 'Permalink',
      };
const articleHref = articleUrl(article, locale);
const sectionHref = sectionUrl(article.section, locale);
const homeHref = localUrl('', locale);
---

<article
  class="article-page"
  data-pagefind-body
  style={`--section-light: ${currentSection.light}; --section-dark: ${currentSection.dark};`}
>
  <header class="article-header">
    <p class="eyebrow">
      <a
        class="section-link"
        href={sectionHref}
        data-pagefind-filter={`section:${article.section}`}
      >
        {currentSectionLabel}
      </a>
      <span aria-hidden="true">·</span>
      <span>{copy.article}</span>
      {article.secondarySections.map((secondarySection) => (
        <span
          class="sr-only"
          data-pagefind-filter={`section:${secondarySection}`}
        >
          {sectionLabel(secondarySection, locale)}
        </span>
      ))}
    </p>

    <h1 data-pagefind-meta="title">{translation.title}</h1>
    <p class="summary" data-pagefind-meta="summary">
      {translation.summary}
    </p>

    <div class="article-meta-row">
      <div class="article-meta">
        <p class="source-line">
          <span>{copy.byline}:</span>
          {article.sources.map((source, index) => (
            <span class="source-item">
              {index > 0 && <span aria-hidden="true">, </span>}
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                {source.name}
              </a>
            </span>
          ))}
        </p>
        <p class="date-line">
          <time datetime={articleDate(article)}>
            {copy.published} {formatArticleDate(article, locale)}
          </time>
          {hasUpdate && (
            <time datetime={article.updatedAt ?? article.publishedAt}>
              <span aria-hidden="true"> · </span>
              {copy.updated} {formatDate(article.updatedAt, locale)}
            </time>
          )}
          <span aria-hidden="true"> · </span>
          <span>
            {readingMinutes} {copy.minute}
          </span>
        </p>
      </div>

      <div
        class="reading-controls"
        data-pagefind-ignore
        aria-label={copy.textSize}
      >
        <button type="button" data-font-decrease aria-label={copy.decrease}>
          A−
        </button>
        <output data-font-value aria-live="polite">
          18px
        </output>
        <button type="button" data-font-increase aria-label={copy.increase}>
          A+
        </button>
      </div>
    </div>
  </header>

  <div
    class="article-content"
    data-article-body
    style="font-size: var(--article-size, 18px)"
  >
    {translation.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}

    {translation.correction && (
      <aside class="correction" aria-label={copy.correction}>
        <p class="correction-label">{copy.correction}</p>
        <p>{translation.correction}</p>
      </aside>
    )}

    <section class="article-sources" aria-labelledby="article-sources-title">
      <h2 id="article-sources-title">{copy.sources}</h2>
      <ul>
        {article.sources.map((source) => (
          <li>
            <a href={source.url} target="_blank" rel="noopener noreferrer">
              {source.name}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <footer class="article-footer">
    <a class="back-link" href={sectionHref}>
      {copy.backToSection} <span aria-hidden="true">→</span>
    </a>
    <span class="footer-links">
      <a class="home-link" href={homeHref}>
        Notícias
      </a>
      <a class="canonical-link" href={articleHref}>
        {copy.permalink}
      </a>
    </span>
  </footer>
</article>

{related.length > 0 && (
  <section
    class="related-stories"
    data-pagefind-ignore
    aria-labelledby="related-stories-title"
  >
    <div class="related-heading">
      <p class="eyebrow">{currentSectionLabel}</p>
      <h2 id="related-stories-title">{copy.related}</h2>
    </div>
    <div class="related-grid">
      {related.map((relatedArticle, index) => (
        <StoryCard article={relatedArticle} locale={locale} rank={index + 1} />
      ))}
    </div>
  </section>
)}

<style>
  .article-page {
    --section-accent: var(--section-light);
    background: var(--paper);
    color: var(--ink);
  }

  .article-header {
    max-width: 65ch;
    margin: 0 auto;
  }

  .eyebrow {
    align-items: center;
    color: var(--section-accent);
    display: flex;
    flex-wrap: wrap;
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    gap: 0.5rem;
    letter-spacing: 0.1em;
    margin: 0 0 1.2rem;
    text-transform: uppercase;
  }

  .section-link,
  .back-link {
    color: var(--section-accent);
    text-decoration-color: color-mix(
      in srgb,
      var(--section-accent),
      transparent 55%
    );
    text-underline-offset: 0.2em;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    color: var(--section-accent);
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 0.98;
    margin-bottom: 1.5rem;
    max-width: 15ch;
  }

  .summary {
    color: var(--muted);
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: clamp(1.2rem, 2.6vw, 1.65rem);
    line-height: 1.35;
    margin-bottom: 2rem;
    max-width: 54ch;
  }

  .article-meta-row {
    align-items: flex-end;
    border-bottom: 1px solid var(--rule);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding-bottom: 1.3rem;
  }

  .article-meta {
    color: var(--section-accent);
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .article-meta p {
    margin-bottom: 0.2rem;
  }

  .source-line > span:first-child {
    color: var(--section-accent);
    font-weight: 700;
  }

  .source-line {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.35rem;
  }

  .source-item {
    align-items: baseline;
    display: inline-flex;
    gap: 0.2rem;
  }

  .source-line a {
    color: var(--section-accent);
    text-underline-offset: 0.15em;
  }

  .date-line {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .reading-controls {
    align-items: center;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--muted);
    display: inline-flex;
    flex: 0 0 auto;
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    gap: 0.15rem;
    padding: 0.15rem;
  }

  .reading-controls button {
    background: transparent;
    border: 0;
    border-radius: 999px;
    color: var(--section-accent);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.76rem;
    font-weight: 700;
    min-height: 1.8rem;
    min-width: 1.8rem;
    padding: 0.15rem 0.3rem;
  }

  .reading-controls button:hover,
  .reading-controls button:focus-visible {
    background: color-mix(in srgb, var(--section-light), transparent 75%);
    outline: 0;
  }

  .article-content {
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: var(--article-size, 18px);
    line-height: 1.72;
    margin: clamp(2.5rem, 7vw, 5rem) auto 0;
    max-width: 65ch;
  }

  .article-content > p:first-child {
    font-size: 1.15em;
  }

  .article-content p {
    margin-bottom: 1.45em;
  }

  .correction {
    border-left: 3px solid var(--section-accent);
    color: var(--muted);
    font-size: 0.92em;
    margin: 2.5rem 0;
    padding: 0.15rem 0 0.15rem 1.2rem;
  }

  .correction p {
    margin-bottom: 0.4rem;
  }

  .correction-label {
    color: var(--section-accent);
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .article-sources {
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    line-height: 1.55;
    margin-top: 3rem;
    padding-top: 1.2rem;
  }

  .article-sources h2 {
    color: var(--ink);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    margin-bottom: 0.6rem;
    text-transform: uppercase;
  }

  .article-sources ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .article-sources a {
    color: var(--section-accent);
  }

  .article-footer {
    display: flex;
    flex-wrap: wrap;
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    gap: 1rem 2rem;
    justify-content: space-between;
    margin: 3.5rem auto 0;
    max-width: 65ch;
    padding: 1.25rem 0 3.5rem;
  }

  .back-link {
    font-weight: 700;
  }

  .canonical-link {
    color: var(--muted);
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }

  .footer-links {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .home-link {
    color: var(--ink);
    font-weight: 700;
  }

  .related-stories {
    background: var(--surface);
    border-top: 1px solid var(--rule);
    padding: clamp(2.5rem, 7vw, 5rem) 0 clamp(3rem, 8vw, 6rem);
  }

  .related-heading {
    align-items: baseline;
    display: flex;
    gap: 1rem 2rem;
    justify-content: space-between;
    margin: 0 auto 1.7rem;
    max-width: 65ch;
  }

  .related-heading .eyebrow {
    margin-bottom: 0;
  }

  .related-heading h2 {
    color: var(--ink);
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    letter-spacing: -0.035em;
    line-height: 1;
    margin-bottom: 0;
  }

  .related-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 auto;
    max-width: 65ch;
  }

  @media (max-width: 48rem) {
    .article-meta-row,
    .related-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .reading-controls {
      align-self: flex-end;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  :global(html[data-theme='dark']) .article-page {
    --section-accent: var(--section-dark);
  }

  @media (min-width: 48.01rem) {
    .article-content,
    .article-footer {
      margin-left: calc(50% - 32.5ch);
      margin-right: calc(50% - 32.5ch);
    }
  }
</style>
