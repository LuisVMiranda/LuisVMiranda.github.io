---
import { sections } from '../modules/content/sections';

export type SearchLocale = 'pt-BR' | 'en';

interface Props {
  locale: SearchLocale;
}

const { locale } = Astro.props;
const copy =
  locale === 'en'
    ? {
        eyebrow: 'Notícias',
        title: 'Search',
        description: 'Find reporting, analysis, and context from Notícias.',
        inputLabel: 'Search Notícias',
        placeholder: 'Search news, topics, or keywords',
        sectionLabel: 'Section',
        allSections: 'All sections',
        submit: 'Search',
        noScript: 'Search requires JavaScript and the published search index.',
      }
    : {
        eyebrow: 'Notícias',
        title: 'Pesquisar',
        description: 'Encontre reportagens, análises e contexto nas Notícias.',
        inputLabel: 'Buscar nas Notícias',
        placeholder: 'Pesquise notícias, temas ou palavras-chave',
        sectionLabel: 'Seção',
        allSections: 'Todas as seções',
        submit: 'Pesquisar',
        noScript: 'A busca precisa de JavaScript e do índice publicado.',
      };

const initialQuery = Astro.url.searchParams.get('q') ?? '';
const initialSection = Astro.url.searchParams.get('section') ?? '';
const inputId = `search-query-${locale}`;
const sectionId = `search-section-${locale}`;
const statusId = `search-status-${locale}`;
---

<section
  class="search-page"
  data-search
  data-pagefind-ignore
  data-locale={locale}
  aria-labelledby={`search-title-${locale}`}
>
  <header class="search-page__header">
    <p class="search-page__eyebrow">{copy.eyebrow}</p>
    <h1 id={`search-title-${locale}`} class="search-page__title">
      {copy.title}
    </h1>
    <p class="search-page__description">{copy.description}</p>
  </header>

  <form class="search-page__form" data-search-form role="search" method="get">
    <div class="search-page__field">
      <label for={inputId}>{copy.inputLabel}</label>
      <input
        id={inputId}
        data-search-input
        type="search"
        name="q"
        value={initialQuery}
        placeholder={copy.placeholder}
        autocomplete="off"
      />
    </div>

    <div class="search-page__field">
      <label for={sectionId}>{copy.sectionLabel}</label>
      <select id={sectionId} data-search-section name="section">
        <option value="" selected={initialSection === ''}>
          {copy.allSections}
        </option>
        {sections.map((section) => (
          <option
            value={section.id}
            selected={initialSection === section.id}
            data-light={section.light}
            data-dark={section.dark}
          >
            {section.label[locale]}
          </option>
        ))}
      </select>
    </div>

    <button class="search-page__submit" type="submit">
      {copy.submit}
    </button>
  </form>

  <p
    id={statusId}
    class="search-page__status"
    data-search-status
    role="status"
    aria-live="polite"
  >
    {initialQuery || initialSection
      ? ''
      : locale === 'en'
        ? 'Enter a term to search.'
        : 'Digite um termo para buscar.'}
  </p>
  <ol class="search-page__results" data-search-results aria-live="polite"></ol>
  <noscript>
    <p class="search-page__noscript">{copy.noScript}</p>
  </noscript>
</section>

<script>
  import { createSearchController } from '../modules/discovery/search';

  const root = document.querySelector('[data-search]');
  if (root instanceof HTMLElement) {
    void createSearchController({ root });
  }
</script>

<style>
  .search-page {
    color: var(--ink);
    margin: 0 auto;
    max-width: 76rem;
    padding: clamp(2rem, 6vw, 5.5rem) clamp(1.25rem, 5vw, 4rem)
      clamp(3rem, 8vw, 7rem);
  }

  .search-page__header {
    border-top: 1px solid var(--rule);
    max-width: 52rem;
    padding-top: 1.35rem;
  }

  .search-page__eyebrow {
    color: var(--muted);
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    margin: 0 0 1.8rem;
    text-transform: uppercase;
  }

  .search-page__title {
    color: var(--ink);
    margin: 0 0 1rem;
    max-width: 12ch;
  }

  .search-page__description {
    color: var(--muted);
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: clamp(1.2rem, 2.5vw, 1.65rem);
    line-height: 1.35;
    margin: 0;
    max-width: 40ch;
  }

  .search-page__form {
    align-items: end;
    border-bottom: 1px solid var(--rule);
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1.8fr) minmax(12rem, 0.8fr) auto;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: 1.5rem;
  }

  .search-page__field {
    display: grid;
    gap: 0.45rem;
  }

  .search-page__field label {
    color: var(--muted);
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .search-page__field input,
  .search-page__field select {
    min-height: 2.9rem;
    width: 100%;
  }

  .search-page__submit {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
    min-width: 7.2rem;
  }

  .search-page__submit:hover {
    background: var(--section-accent, var(--muted));
    border-color: var(--section-accent, var(--muted));
  }

  .search-page__status {
    color: var(--muted);
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    margin: 1.25rem 0;
    min-height: 1.5em;
  }

  .search-page__results {
    border-top: 1px solid var(--rule);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .search-result {
    border-bottom: 1px solid var(--rule);
    padding: 1.25rem 0 1.4rem;
  }

  .search-result__title {
    color: var(--ink);
    display: inline-block;
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
  }

  .search-result__title:hover,
  .search-result__title:focus-visible {
    color: var(--section-accent, var(--ink));
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .search-result__summary {
    color: var(--muted);
    margin: 0.55rem 0 0;
    max-width: 68ch;
  }

  .search-page__noscript {
    color: var(--muted);
    margin-top: 1.25rem;
  }

  @media (max-width: 48rem) {
    .search-page__form {
      grid-template-columns: 1fr 1fr;
    }

    .search-page__submit {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }

  @media (max-width: 30rem) {
    .search-page__form {
      grid-template-columns: 1fr;
    }

    .search-page__submit {
      grid-column: auto;
      width: 100%;
    }
  }
</style>
