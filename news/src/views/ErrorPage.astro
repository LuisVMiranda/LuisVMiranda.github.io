---
import type { Locale } from '../modules/content/types';
import { localUrl } from '../modules/content/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const en = locale === 'en';
const alternateLocale: Locale = en ? 'pt-BR' : 'en';
const copy = en
  ? {
      eyebrow: 'Error 404',
      title: 'This page could not be found.',
      description:
        'The address may be out of date, or the page may have moved. Start again from the latest edition or search our reporting.',
      home: 'Back to the front page',
      search: 'Search Notícias',
      portfolio: 'Portfolio',
      language: 'Português',
      actions: 'Page navigation',
    }
  : {
      eyebrow: 'Erro 404',
      title: 'Esta página não foi encontrada.',
      description:
        'O endereço pode estar desatualizado ou a página pode ter mudado. Volte à edição mais recente ou pesquise em nosso acervo.',
      home: 'Voltar para a capa',
      search: 'Buscar nas Notícias',
      portfolio: 'Portfólio',
      language: 'English',
      actions: 'Navegação da página',
    };
---

<section class="error-page" aria-labelledby="error-page-title">
  <div class="error-page__content">
    <p class="error-page__eyebrow">{copy.eyebrow}</p>
    <h1 id="error-page-title">{copy.title}</h1>
    <p class="error-page__description">{copy.description}</p>

    <nav class="error-page__actions" aria-label={copy.actions}>
      <a
        class="error-page__action error-page__action--primary"
        href={localUrl('', locale)}
      >
        {copy.home} <span aria-hidden="true">↗</span>
      </a>
      <a class="error-page__action" href={localUrl('busca', locale)}>
        {copy.search} <span aria-hidden="true">↗</span>
      </a>
      <a class="error-page__action" href="/">
        {copy.portfolio} <span aria-hidden="true">↗</span>
      </a>
      <a
        class="error-page__action error-page__action--language"
        href={localUrl('404', alternateLocale)}
        lang={alternateLocale}
        hreflang={alternateLocale}
      >
        {copy.language}
      </a>
    </nav>
  </div>
</section>

<style>
  .error-page {
    margin: 0 auto;
    max-width: 58rem;
    min-height: clamp(24rem, 58vh, 38rem);
    padding: clamp(3rem, 9vw, 7rem) clamp(1.25rem, 5vw, 4rem)
      clamp(4rem, 10vw, 7rem);
  }

  .error-page__content {
    background: var(--surface);
    border-top: 2px solid var(--section-accent);
    max-width: 48rem;
    padding: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 4vw, 3rem)
      clamp(1.75rem, 4vw, 3rem);
  }

  .error-page__eyebrow {
    color: var(--section-accent);
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    margin: 0 0 1.5rem;
    text-transform: uppercase;
  }

  h1 {
    color: var(--ink);
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: clamp(2.7rem, 7vw, 5.25rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.98;
    margin: 0 0 1.5rem;
    max-width: 12ch;
  }

  .error-page__description {
    color: var(--muted);
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    line-height: 1.4;
    margin: 0;
    max-width: 42ch;
  }

  .error-page__actions {
    align-items: center;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: clamp(2rem, 5vw, 3rem);
    padding-top: 1.25rem;
  }

  .error-page__action {
    align-items: center;
    border: 1px solid var(--rule);
    color: var(--ink);
    display: inline-flex;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    gap: 0.55rem;
    justify-content: center;
    min-height: 2.9rem;
    padding: 0.65rem 0.9rem;
    text-decoration: none;
  }

  .error-page__action:hover,
  .error-page__action:focus-visible {
    border-color: var(--section-accent);
    color: var(--section-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .error-page__action--primary {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .error-page__action--primary:hover,
  .error-page__action--primary:focus-visible {
    background: var(--section-accent);
    border-color: var(--section-accent);
    color: var(--paper);
  }

  @media (max-width: 30rem) {
    .error-page {
      padding-inline: 0;
    }

    .error-page__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .error-page__action {
      width: 100%;
    }
  }
</style>
