---
import type {
  Article,
  Edition,
  Locale,
  SectionId,
} from '../modules/content/types';
import {
  sectionLabel,
  sections,
  sectionStyle,
} from '../modules/content/sections';
import { formatDate, localUrl } from '../modules/content/urls';
import StoryCard from '../components/StoryCard.astro';

interface Props {
  locale: Locale;
  articles: Article[];
  editions: Edition[];
  selectedEdition?: Edition;
  page?: number;
  pageCount?: number;
  sectionFilter?: SectionId;
}

const {
  locale,
  articles,
  editions,
  selectedEdition,
  page = 1,
  pageCount,
  sectionFilter,
} = Astro.props;
const en = locale === 'en';
const pageSize = 10;
const orderedEditions = [...editions].sort((a, b) =>
  b.cutoff.localeCompare(a.cutoff),
);
const scopedEditions = sectionFilter
  ? orderedEditions.filter(
      (edition) => edition.sections[sectionFilter].articleIds.length > 0,
    )
  : orderedEditions;
const totalPages = Math.max(
  1,
  pageCount ?? Math.ceil(scopedEditions.length / pageSize),
);
const currentPage = Math.min(Math.max(1, page), totalPages);
const visibleEditions = scopedEditions.slice(
  (currentPage - 1) * pageSize,
  currentPage * pageSize,
);
const articleById = new Map(articles.map((article) => [article.id, article]));

const copy = en
  ? {
      eyebrow: 'Editorial archive',
      title: 'Edition archive',
      description:
        'Browse verified selections by date, then open any edition to read its ranked desks.',
      editions: 'Editions',
      edition: 'Edition',
      openEdition: 'Open edition',
      filter: 'Filter by desk',
      allDesks: 'All desks',
      stories: 'stories',
      previous: 'Previous page',
      next: 'Next page',
      page: 'Page',
      of: 'of',
      back: 'Back to archive',
      selection: 'The verified selection',
      noStories:
        'No verified stories are available in this desk for this edition.',
      shortfall: 'This desk published fewer than ten stories:',
      genericShortfall:
        'This desk has fewer than ten verified stories in this edition.',
      filtered: 'Showing editions that include',
      allShown: 'Showing all desks.',
    }
  : {
      eyebrow: 'Arquivo editorial',
      title: 'Arquivo de edições',
      description:
        'Consulte as seleções verificadas por data e abra qualquer edição para ler suas editorias ranqueadas.',
      editions: 'Edições',
      edition: 'Edição',
      openEdition: 'Abrir edição',
      filter: 'Filtrar por editoria',
      allDesks: 'Todas as editorias',
      stories: 'notícias',
      previous: 'Página anterior',
      next: 'Próxima página',
      page: 'Página',
      of: 'de',
      back: 'Voltar ao arquivo',
      selection: 'A seleção verificada',
      noStories:
        'Não há notícias verificadas disponíveis nesta editoria para esta edição.',
      shortfall: 'Esta editoria publicou menos de dez notícias:',
      genericShortfall:
        'Esta editoria tem menos de dez notícias verificadas nesta edição.',
      filtered: 'Exibindo edições que incluem',
      allShown: 'Exibindo todas as editorias.',
    };

function archiveUrl(section?: SectionId, pageNumber = 1): string {
  const path = section
    ? `arquivo/secao/${section}${pageNumber > 1 ? `/pagina/${pageNumber}` : ''}`
    : `arquivo${pageNumber > 1 ? `/pagina/${pageNumber}` : ''}`;
  return localUrl(path, locale);
}

function editionSections(edition: Edition, sectionId: SectionId): Article[] {
  return edition.sections[sectionId].articleIds
    .map((articleId) => articleById.get(articleId))
    .filter((article): article is Article => Boolean(article));
}

function shortfallText(edition: Edition, sectionId: SectionId): string {
  const entry = edition.sections[
    sectionId
  ] as Edition['sections'][SectionId] & {
    shortfallEn?: string;
  };
  return en
    ? entry.shortfallEn?.trim() || copy.genericShortfall
    : entry.shortfall.trim() || copy.genericShortfall;
}

function editionStoryCount(edition: Edition): number {
  const articleIds = sections.flatMap(
    (section) => edition.sections[section.id].articleIds,
  );
  return new Set(articleIds).size;
}

const filterStatus = sectionFilter
  ? `${copy.filtered} ${sectionLabel(sectionFilter, locale)}.`
  : copy.allShown;
---

<div class="archive-page">
  {selectedEdition ? (
    <>
      <header class="archive-header edition-header">
        <a class="back-link" href={localUrl('arquivo', locale)}>
          ← {copy.back}
        </a>
        <p class="eyebrow">{copy.edition}</p>
        <h1>{formatDate(selectedEdition.cutoff, locale)}</h1>
        <p class="archive-description">{copy.selection}</p>
        <nav class="desk-nav" aria-label={copy.filter}>
          <a
            href={localUrl(`edicao/${selectedEdition.id}`, locale)}
            aria-current="page"
          >
            {copy.allDesks}
          </a>
          {sections.map((section) => (
            <a href={`#section-${section.id}`} style={sectionStyle(section.id)}>
              {section.label[locale]}
            </a>
          ))}
        </nav>
      </header>

      <section
        class="edition-sections"
        aria-labelledby="edition-sections-title"
      >
        <div class="section-heading">
          <p class="eyebrow" id="edition-sections-title">
            {copy.edition}
          </p>
          <time datetime={selectedEdition.cutoff}>
            {formatDate(selectedEdition.cutoff, locale)}
          </time>
        </div>
        <div class="section-list">
          {sections.map((section) => {
            const ranked = editionSections(selectedEdition, section.id);
            return (
              <section
                id={`section-${section.id}`}
                class="desk-section"
                data-section-panel={section.id}
                style={sectionStyle(section.id)}
                aria-labelledby={`desk-title-${section.id}`}
              >
                <header class="desk-heading">
                  <div>
                    <p class="desk-kicker">{section.label[locale]}</p>
                    <h2 id={`desk-title-${section.id}`}>
                      {section.label[locale]}
                    </h2>
                  </div>
                  <span class="desk-count">{ranked.length}/10</span>
                </header>
                {ranked.length > 0 ? (
                  <div class="ranked-stories">
                    {ranked.map((article, index) => (
                      <StoryCard
                        article={article}
                        locale={locale}
                        rank={index + 1}
                      />
                    ))}
                  </div>
                ) : (
                  <p class="empty-state">{copy.noStories}</p>
                )}
                {ranked.length < 10 && (
                  <p class="shortfall">
                    <strong>{copy.shortfall}</strong>{' '}
                    {shortfallText(selectedEdition, section.id)}
                  </p>
                )}
              </section>
            );
          })}
        </div>
      </section>
    </>
  ) : (
    <>
      <header class="archive-header">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
        <p class="archive-description">{copy.description}</p>
      </header>

      <section class="archive-browser" aria-labelledby="archive-list-title">
        <div class="browser-heading">
          <div>
            <p class="eyebrow" id="archive-list-title">
              {copy.editions}
            </p>
            <p class="filter-status">{filterStatus}</p>
          </div>
          <nav class="desk-nav" aria-label={copy.filter}>
            <a
              href={archiveUrl()}
              aria-current={sectionFilter ? undefined : 'page'}
            >
              {copy.allDesks}
            </a>
            {sections.map((section) => (
              <a
                href={archiveUrl(section.id)}
                aria-current={sectionFilter === section.id ? 'page' : undefined}
                style={sectionStyle(section.id)}
              >
                {section.label[locale]}
              </a>
            ))}
          </nav>
        </div>

        {scopedEditions.length > 0 ? (
          <ol class="edition-list" id="archive-editions">
            {visibleEditions.map((edition, index) => (
              <li class="edition-row">
                <time class="edition-date" datetime={edition.cutoff}>
                  {formatDate(edition.cutoff, locale)}
                </time>
                <div class="edition-summary">
                  <p class="edition-number">
                    {copy.edition}{' '}
                    {scopedEditions.length -
                      ((currentPage - 1) * pageSize + index)}
                  </p>
                  <p class="edition-count">
                    {editionStoryCount(edition)} {copy.stories}
                  </p>
                </div>
                <a
                  class="edition-link"
                  href={localUrl(`edicao/${edition.id}`, locale)}
                >
                  {copy.openEdition} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="empty-state">{copy.noStories}</p>
        )}

        {totalPages > 1 && (
          <nav
            class="pagination"
            aria-label={en ? 'Archive pages' : 'Páginas do arquivo'}
          >
            {currentPage > 1 ? (
              <a href={archiveUrl(sectionFilter, currentPage - 1)}>
                {copy.previous}
              </a>
            ) : (
              <span aria-hidden="true">{copy.previous}</span>
            )}
            <span aria-current="page">
              {copy.page} {currentPage} {copy.of} {totalPages}
            </span>
            {currentPage < totalPages ? (
              <a href={archiveUrl(sectionFilter, currentPage + 1)}>
                {copy.next}
              </a>
            ) : (
              <span aria-hidden="true">{copy.next}</span>
            )}
          </nav>
        )}
      </section>
    </>
  )}
</div>

<style>
  .archive-page {
    color: var(--ink);
    margin: 0 auto;
    max-width: 76rem;
    padding: clamp(2rem, 6vw, 5.5rem) clamp(1.25rem, 5vw, 4rem)
      clamp(3rem, 8vw, 7rem);
  }

  .archive-header {
    border-top: 1px solid var(--rule);
    padding-top: 1.35rem;
  }
  .archive-header h1 {
    margin: 0.6rem 0 1rem;
  }
  .eyebrow {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    margin: 0 0 1.5rem;
    text-transform: uppercase;
  }
  .archive-description {
    color: var(--muted);
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: clamp(1.2rem, 2.5vw, 1.65rem);
    line-height: 1.35;
    margin: 0;
    max-width: 45ch;
  }
  .archive-browser {
    margin-top: clamp(3rem, 7vw, 5.5rem);
  }
  .browser-heading {
    align-items: end;
    border-bottom: 1px solid var(--rule);
    display: flex;
    gap: 1.5rem;
    justify-content: space-between;
    padding-bottom: 1rem;
  }
  .browser-heading .eyebrow {
    margin-bottom: 0.35rem;
  }
  .filter-status {
    color: var(--muted);
    font-size: 0.75rem;
    margin: 0;
  }
  .desk-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    justify-content: flex-end;
  }
  .desk-nav a {
    border-bottom: 2px solid transparent;
    color: var(--muted);
    font-size: 0.72rem;
    min-height: 2.25rem;
    padding: 0.45rem 0;
    text-decoration: none;
  }
  .desk-nav a:hover,
  .desk-nav a:focus-visible,
  .desk-nav a[aria-current='page'] {
    border-bottom-color: var(--section-accent, var(--ink));
    color: var(--section-accent, var(--ink));
  }
  .edition-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .edition-row {
    align-items: center;
    border-bottom: 1px solid var(--rule);
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(10rem, 1fr) minmax(11rem, 1fr) auto;
    padding: 1.35rem 0;
  }
  .edition-date {
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .edition-number {
    font-size: 0.78rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
  }
  .edition-count {
    color: var(--muted);
    font-size: 0.76rem;
    margin: 0;
  }
  .edition-link {
    color: var(--section-accent, var(--ink));
    font-size: 0.76rem;
    font-weight: 700;
    min-height: 2.5rem;
    padding-block: 0.65rem;
    text-decoration: none;
  }
  .edition-link:hover,
  .edition-link:focus-visible,
  .back-link:hover,
  .back-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .pagination {
    align-items: center;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    margin-top: 1.5rem;
    padding-top: 1.1rem;
  }
  .pagination a,
  .pagination span {
    color: var(--muted);
    font-size: 0.75rem;
    min-height: 2.25rem;
    padding-block: 0.5rem;
  }
  .pagination a {
    color: var(--ink);
    font-weight: 700;
  }
  .pagination [aria-current='page'] {
    color: var(--section-accent, var(--ink));
  }
  .back-link {
    color: var(--section-accent, var(--ink));
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    margin-bottom: 2.3rem;
    text-decoration: none;
  }
  .edition-header h1 {
    color: var(--section-accent, var(--ink));
  }
  .edition-header .desk-nav {
    justify-content: flex-start;
    margin-top: 2rem;
  }
  .edition-sections {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .section-heading {
    align-items: baseline;
    border-bottom: 1px solid var(--rule);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding-bottom: 0.9rem;
  }
  .section-heading time {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .section-list {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .desk-section {
    min-width: 0;
    padding-top: 1.5rem;
  }
  .desk-heading {
    align-items: baseline;
    border-bottom: 2px solid var(--section-accent);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 0.2rem;
    padding-bottom: 0.65rem;
  }
  .desk-kicker {
    color: var(--section-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin: 0 0 0.25rem;
    text-transform: uppercase;
  }
  .desk-heading h2 {
    color: var(--section-accent);
    font-size: clamp(1.45rem, 3vw, 2rem);
    margin: 0;
  }
  .desk-count {
    color: var(--muted);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .empty-state,
  .shortfall {
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }
  .empty-state {
    border-bottom: 1px solid var(--rule);
    margin: 0;
    padding: 1.2rem 0;
  }
  .shortfall {
    border-top: 1px solid var(--rule);
    margin: 0;
    padding-top: 1rem;
  }
  .shortfall strong {
    color: var(--section-accent, var(--muted));
  }
  @media (max-width: 34rem) {
    .browser-heading {
      align-items: flex-start;
      flex-direction: column;
    }
    .desk-nav {
      justify-content: flex-start;
    }
    .section-list {
      grid-template-columns: 1fr;
    }
    .edition-row {
      grid-template-columns: 1fr;
    }
    .edition-header .desk-nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
    }
    .pagination {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
