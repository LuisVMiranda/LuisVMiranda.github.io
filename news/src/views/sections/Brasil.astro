---
import type { Article, Edition, Locale } from '../../modules/content/types';
import SectionPage from '../../components/SectionPage.astro';

interface Props {
  locale: Locale;
  articles: Article[];
  edition?: Edition;
}

const { locale, articles, edition } = Astro.props;
const copy =
  locale === 'pt-BR'
    ? {
        kicker: 'Brasil em foco',
        intro:
          'As decisões, acontecimentos e histórias que ajudam a entender o país hoje — com contexto para além do título.',
      }
    : {
        kicker: 'Brazil in focus',
        intro:
          'The decisions, events and stories that help make sense of Brazil today — with context beyond the headline.',
      };
---

<SectionPage
  locale={locale}
  articles={articles}
  edition={edition}
  sectionId="brasil"
  kicker={copy.kicker}
  intro={copy.intro}
/>
