---
import type { Article, Edition, Locale } from '../../modules/content/types';
import SectionPage from '../../components/SectionPage.astro';

interface Props {
  locale: Locale;
  articles: Article[];
  edition?: Edition;
}

const { locale, articles, edition } = Astro.props;
const copy =
  locale === 'pt-BR'
    ? {
        kicker: 'Política em foco',
        intro:
          'As decisões, disputas e propostas que ajudam a entender o poder no Brasil — com contexto para além do título.',
      }
    : {
        kicker: 'Politics in focus',
        intro:
          'The decisions, disputes and proposals that help explain power in Brazil — with context beyond the headline.',
      };
---

<SectionPage
  locale={locale}
  articles={articles}
  edition={edition}
  sectionId="politica"
  kicker={copy.kicker}
  intro={copy.intro}
/>
