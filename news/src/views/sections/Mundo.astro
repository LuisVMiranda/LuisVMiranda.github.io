---
import type { Article, Edition, Locale } from '../../modules/content/types';
import SectionPage from '../../components/SectionPage.astro';

interface Props {
  locale: Locale;
  articles: Article[];
  edition?: Edition;
}

const { locale, articles, edition } = Astro.props;
const copy =
  locale === 'pt-BR'
    ? {
        kicker: 'Mundo em foco',
        intro:
          'Diplomacia, conflitos e decisões internacionais que redesenham o cenário global.',
      }
    : {
        kicker: 'World in focus',
        intro:
          'Diplomacy, conflicts, and international decisions reshaping the global landscape.',
      };
---

<SectionPage
  locale={locale}
  articles={articles}
  edition={edition}
  sectionId="mundo"
  kicker={copy.kicker}
  intro={copy.intro}
/>
