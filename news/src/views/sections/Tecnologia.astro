---
import type { Article, Edition, Locale } from '../../modules/content/types';
import SectionPage from '../../components/SectionPage.astro';

interface Props {
  locale: Locale;
  articles: Article[];
  edition?: Edition;
}

const { locale, articles, edition } = Astro.props;
const copy =
  locale === 'pt-BR'
    ? {
        kicker: 'Tecnologia em contexto',
        intro:
          'As decisões, ferramentas e descobertas que mudam a vida digital — com fontes, contexto e limites claros.',
      }
    : {
        kicker: 'Technology in context',
        intro:
          'The decisions, tools and discoveries reshaping digital life — with sources, context and clear limits.',
      };
---

<SectionPage
  locale={locale}
  articles={articles}
  edition={edition}
  sectionId="tecnologia"
  kicker={copy.kicker}
  intro={copy.intro}
/>
