{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "src/modules/**/*.ts",
    "src/render/**/*.js",
    "src/render/**/*.ts",
    "src/client/**/*.js"
  ],
  "exclude": []
}
