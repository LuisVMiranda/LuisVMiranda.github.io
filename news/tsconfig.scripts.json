{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["scripts/**/*.ts", "src/modules/**/*.ts", ".astro/types.d.ts"],
  "exclude": ["src/modules/discovery/client.ts"]
}
