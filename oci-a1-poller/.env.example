# OCI authentication. The config file must contain an API-key profile.
OCI_CONFIG_FILE=C:/Users/<you>/.oci/config
OCI_PROFILE=DEFAULT
OCI_REGION=sa-saopaulo-1

# Required launch inputs from your OCI tenancy.
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..replace-me
OCI_AVAILABILITY_DOMAIN=SA-SAOPAULO-1-AD-1
OCI_SUBNET_ID=ocid1.subnet.oc1.sa-saopaulo-1.replace-me
OCI_IMAGE_ID=ocid1.image.oc1.sa-saopaulo-1.replace-me

# Always Free A1 defaults. Keep these at 2 OCPUs / 12 GB unless you
# intentionally have a larger eligible quota.
OCI_SHAPE=VM.Standard.A1.Flex
OCI_A1_OCPUS=2
OCI_A1_MEMORY_GB=12
OCI_DISPLAY_NAME=free-a1-poller
OCI_ASSIGN_PUBLIC_IP=true
OCI_BOOT_VOLUME_GB=50

# Local state and report formatting.
A1_POLLER_STATE_FILE=state.json
REPORT_TIMEZONE=America/Sao_Paulo

# Instagram Graph API. Set the currently supported API version.
# The Instagram account must be a Professional account with messaging access.
INSTAGRAM_GRAPH_API_BASE=https://graph.instagram.com
INSTAGRAM_API_VERSION=replace-with-current-supported-version
INSTAGRAM_IG_USER_ID=replace-with-your-instagram-professional-account-id
INSTAGRAM_RECIPIENT_ID=replace-with-your-instagram-scoped-recipient-id
INSTAGRAM_ACCESS_TOKEN=replace-with-a-token-kept-only-in-this-local-file
INSTAGRAM_TIMEOUT_SECONDS=20
